# Kamal sources this file at deploy time and exposes each variable to
# config/deploy.yml. This file IS checked in — never put raw values here.
# Real secrets come from the shell, else from the gitignored .env, through
# bin/secret. Copy .env.example → .env, fill in real values, then run
# `bin/kamal deploy`.

# ghcr.io personal access token (write:packages scope)
KAMAL_REGISTRY_PASSWORD=$(bin/secret KAMAL_REGISTRY_PASSWORD)

# Rails encrypted-credentials key — read from the local file Rails writes.
RAILS_MASTER_KEY=$(cat config/master.key)

# Postgres password (used by both the Rails app and the Postgres accessory).
GOAL_ATLAS_DATABASE_PASSWORD=$(bin/secret GOAL_ATLAS_DATABASE_PASSWORD)
POSTGRES_PASSWORD=$(bin/secret GOAL_ATLAS_DATABASE_PASSWORD)

# Third-party API keys (same values as local .env).
YOUTUBE_API_KEY=$(bin/secret YOUTUBE_API_KEY)
OPENAI_API_KEY=$(bin/secret OPENAI_API_KEY)
GEMINI_API_KEY=$(bin/secret GEMINI_API_KEY)
API_FOOTBALL_KEY=$(bin/secret API_FOOTBALL_KEY)

# Cloudflare R2: the nightly pg_dump goes to a bucket of its own, goal-atlas-backups.
R2_ACCESS_KEY_ID=$(bin/secret R2_ACCESS_KEY_ID)
R2_SECRET_ACCESS_KEY=$(bin/secret R2_SECRET_ACCESS_KEY)
R2_ENDPOINT=$(bin/secret R2_ENDPOINT)
R2_BUCKET=$(bin/secret R2_BUCKET)

# Email of the admin user created if the seed is re-run on prod. The dump
# restore at cutover means this is normally not needed, but it's wired up
# for safety in case the prod DB is ever wiped + reseeded.
ADMIN_EMAIL=$(bin/secret ADMIN_EMAIL)
